{
  "name": "alice-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "艾莉絲的 Web Studio（由 Alice Core 提供靜態檔）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:hosted": "vue-tsc --noEmit && vite build --mode hosted --base ./ --outDir dist-hosted"
  },
  "dependencies": {
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
